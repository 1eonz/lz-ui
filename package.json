{
  "name": "lx-ui",
  "version": "0.0.0-alpha.0",
  "description": "面向 React PC 中后台的 lx-ui 组件库基础工程",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./antd": {
      "types": "./dist/esm/antd.d.ts",
      "import": "./dist/esm/antd.js",
      "require": "./dist/cjs/antd.cjs"
    },
    "./business": {
      "types": "./dist/esm/business.d.ts",
      "import": "./dist/esm/business.js",
      "require": "./dist/cjs/business.cjs"
    },
    "./theme": {
      "types": "./dist/esm/theme/index.d.ts",
      "import": "./dist/esm/theme/index.js",
      "require": "./dist/cjs/theme/index.cjs"
    },
    "./style.css": "./dist/esm/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "antd": ">=5.24 <6",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "scripts": {
    "dev": "dumi dev",
    "dev:docs": "dumi dev",
    "build": "npm run check && npm run build:lib && npm run build:docs",
    "build:lib": "father build",
    "build:docs": "dumi build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "clean": "node scripts/clean.mjs",
    "release:guard": "node scripts/release-guard.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "antd": "^5.24.0",
    "dumi": "^2.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "father": "^4.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
